# Copy this file to .env and fill in your actual values
# Never commit .env — it is listed in .gitignore

# AWS Bedrock credentials — required for Claude generation and RAGAS eval
# Obtain temporary credentials from your AWS account (STS session token)
AWS_ACCESS_KEY_ID=ASIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=your-40-character-secret-key
AWS_SESSION_TOKEN=your-session-token
AWS_DEFAULT_REGION=ap-south-1

# HuggingFace token — required for downloading bge-small embedding model on first run
HF_TOKEN=hf_your-token-here
